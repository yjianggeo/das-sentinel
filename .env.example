# Compose deployment environment for DAS Sentinel.
# Copy to .env and fill in real values; .env is gitignored.

# Absolute path of the read-only raw DAS data tree on the host.
DAS_DATA_ROOT=/path/to/raw-das-data

# Secrets (>= 32 chars each). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DAS_SESSION_SECRET=change-me-session-secret-at-least-32-chars
DAS_WORKER_TOKEN=change-me-worker-token-at-least-32-chars

# Set to true only when serving behind HTTPS.
DAS_SECURE_COOKIES=false
